<?xml version="1.0" encoding="utf-8"?>
<!--
  The main screen: a scrollable column of text, two switches and two buttons.
  fitsSystemWindows keeps content clear of the status bar and navigation bar.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Shows whether the service is switched on in Android's settings. -->
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Main on/off switch. -->
        <Switch
            android:id="@+id/blockingSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:text="@string/blocking_switch"
            android:textSize="18sp" />

        <!-- What to block. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/what_to_block"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/blockShorts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/block_shorts" />

        <CheckBox
            android:id="@+id/blockHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/block_home" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:alpha="0.7"
            android:text="@string/block_home_hint"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/debugSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/debug_switch" />

        <Button
            android:id="@+id/openAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/open_accessibility" />

        <Button
            android:id="@+id/openAppInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_app_info" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/how_to" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:alpha="0.7"
            android:text="@string/privacy"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
